        <label><input type="checkbox" name="modex[]" value="lara" /> Laravel</label>
        <label><input type="checkbox" name="modex[]" value="statis" /> Static / Random</label>
    </fieldset>

    <button type="submit">Gass Tebar</button>
</form>

